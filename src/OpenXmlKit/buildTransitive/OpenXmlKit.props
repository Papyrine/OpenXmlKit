    <Using Include="OpenXmlKit.Word.Bookmarks" Alias="WBookmarks" />
    <Using Include="OpenXmlKit.Word.Border" Alias="WBorder" />
    <Using Include="OpenXmlKit.Word.BorderStyle" Alias="WBorderStyle" />
    <Using Include="OpenXmlKit.Word.Borders" Alias="WBorders" />
    <Using Include="OpenXmlKit.Word.BreakKind" Alias="WBreakKind" />
    <Using Include="OpenXmlKit.Word.BuiltInStyle" Alias="WBuiltInStyle" />
    <Using Include="OpenXmlKit.Word.Cell" Alias="WCell" />
