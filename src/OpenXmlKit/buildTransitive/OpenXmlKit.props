<Project>

  <!--
    Generated by OpenXmlKit.Tests.AliasPropsTests. Do not edit by hand.

    OpenXmlKit names its types after what they are, which is what the SDK's Wordprocessing
    namespace does too. A project that imports both gets an ambiguous reference on every
    shared name. Setting OpenXmlKitAliases gives prefixed aliases instead:

      <PropertyGroup>
        <OpenXmlKitAliases>W</OpenXmlKitAliases>
      </PropertyGroup>

    The value is either W or Word, giving WParagraph or WordParagraph.

    In alias mode, do not also import OpenXmlKit.Word. An alias avoids the ambiguity by
    keeping the bare names out of scope; importing the namespace as well puts them back.
  -->

  <ItemGroup Condition="'$(OpenXmlKitAliases)' == 'W'">
    <Using Include="OpenXmlKit.Length" Alias="WLength" />
    <Using Include="OpenXmlKit.Toggle" Alias="WToggle" />
    <Using Include="OpenXmlKit.Width" Alias="WWidth" />
    <Using Include="OpenXmlKit.WidthUnit" Alias="WWidthUnit" />
    <Using Include="OpenXmlKit.Word.BlockContainer" Alias="WBlockContainer" />
