<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Sbom.Targets" PrivateAssets="all" Condition="'$(CI)' == 'true'" />
    <PackageReference Include="System.Memory" Condition="'$(TargetFramework)' == 'net48'" />
    <None Include="buildTransitive\OpenXmlKit.props" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\OpenXmlKit.props" Pack="true" PackagePath="build\" />
    <None Include="nuget-readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
